#!/bin/bash
#
# Derived from ani-cli (GPL-3.0-or-later) -- see NOTICE.

set -uo pipefail

export LC_ALL=C

BASE_API="${OMANI_BASE_API:-https://hianime.at}"
AGENT="${OMANI_AGENT:-Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36}"

die() {
  printf 'omani-provider: %s\n' "$1" >&2
  exit 1
}

# curl-impersonate builds get past Cloudflare where plain curl does not.
pick_curl() {
  local candidate
  for candidate in curl_firefox135 curl_chrome136 curl_chrome116 curl_ff117 curl; do
    command -v "$candidate" >/dev/null && printf '%s\n' "$candidate" && return 0
  done
  return 1
}

CURL="${OMANI_CURL:-$(pick_curl)}" || die "curl not found"

fetch() {
  local body status
  [[ ${1:-} == https://* || ${1:-} == http://* ]] || die "not a web address: ${1:-}"
  body=$("$CURL" -sL -A "$AGENT" --max-time 15 \
    --proto '=http,https' --proto-redir '=http,https' \
    -w ' %{http_code}' "$@") || status=$?
  local code=${body##* }
  body=${body% *}
  if [[ -n ${status:-} ]]; then
    die "could not fetch $1 (HTTP ${code:-none}, curl exit $status)"
  fi
  if grep -qi "<title>Just a moment" <<<"$body"; then
    [[ $CURL == curl ]] && die "blocked by cloudflare; install curl-impersonate"
    die "blocked by cloudflare"
  fi
  [[ $code == 2?? ]] || die "HTTP $code from $1"
  printf '%s' "$body"
}

AWK_ATTR='
function attr(line, key,   m) {
  if (!match(line, key "=\"[^\"]*\"")) return ""
  m = substr(line, RSTART, RLENGTH)
  return substr(m, length(key) + 3, length(m) - length(key) - 3)
}
function clean(value) {
  gsub(/\t/, " ", value)
  return value
}
'

parse_search() {
  sed '/id="main-sidebar"/,$d' | tr '\n' ' ' |
    sed 's|<div class="film-detail">|\n<div class="film-detail">|g' |
    awk "$AWK_ATTR"'
      {
        at = index($0, "film-name")
        if (!at) next
        rest = substr($0, at)
        href = attr(rest, "href")
        title = attr(rest, "title")
        if (href == "" || title == "") next
        sub(/.*\//, "", href)
        if (href == "") next
        print clean(href) "\t" clean(title)
      }
    ' |
    sed -e "s|&#039;|'|g" -e 's|&quot;|"|g' -e "s|&amp;|\&|g"
}

parse_episodes() {
  sed 's|\\||g; s|ep-item|\nep-item|g' |
    series="$1" awk "$AWK_ATTR"'
      {
        if (index($0, "/watch/" ENVIRON["series"] "?ep=") == 0) next
        number = attr($0, "data-number")
        id = attr($0, "data-id")
        if (number == "" || id !~ /^[0-9]+$/) next
        print id "\t" clean(number)
      }
    '
}

b64_decode() {
  base64 -d 2>/dev/null <<<"$1"
}

# The sources endpoint seals the playlist with a fixed key, so openssl can open
# it without running the site's own javascript. base64url leaves out the padding
# openssl insists on.
decrypt_playlist() {
  local key iv pad
  key=$(printf '%s' 'i?LMTAx0Q6,:}50U' | od -v -An -tx1 | tr -d ' \n')
  iv=$(printf '%s' "W0;27ToaUpl_P%'c" | od -v -An -tx1 | tr -d ' \n')
  case "$((${#1} % 4))" in
  2) pad="==" ;;
  3) pad="=" ;;
  *) pad="" ;;
  esac
  printf '%s%s' "$1" "$pad" | tr '_-' '/+' |
    openssl enc -d -aes-256-cbc -a -A -K "${key}00000000000000000000000000000000" -iv "$iv" 2>/dev/null
}

parse_qualities() {
  base="${1%/*}" awk '
    /^#EXT-X-I-FRAME-STREAM-INF/ { next }
    /^#EXT-X-STREAM-INF/ {
      height = ""
      if (match($0, /RESOLUTION=[0-9]+x[0-9]+/))
        height = substr($0, RSTART + 11, RLENGTH - 11)
      sub(/^[0-9]+x/, "", height)
      next
    }
    /^#/ { next }
    height != "" && NF {
      url = $0
      if (url !~ /^https?:\/\//) url = ENVIRON["base"] "/" url
      print height "p >" url
      height = ""
    }
  ' | sort -g -r -s
}

heights_of() {
  sed -nE 's#^([0-9]+)p? *>.*#\1#p' <<<"$1" | tr '\n' ' ' | sed 's# *$##'
}

pick_quality() {
  local wanted="$1" links="$2" chosen
  case "$wanted" in
  best) chosen=$(head -n 1 <<<"$links") ;;
  worst) chosen=$(grep -E '^[0-9]{3,4}' <<<"$links" | tail -n 1) ;;
  *) chosen=$(grep -m 1 -E "^${wanted}p? *>" <<<"$links") ;;
  esac
  [[ -n $chosen ]] || chosen=$(head -n 1 <<<"$links")
  cut -d '>' -f 2 <<<"$chosen"
}

urlencode() {
  local out="" byte i
  for ((i = 0; i < ${#1}; i++)); do
    byte=${1:i:1}
    case $byte in
    [a-zA-Z0-9.~_-]) out+=$byte ;;
    *)
      printf -v byte '%%%02X' "'$byte"
      out+=$byte
      ;;
    esac
  done
  printf '%s' "$out"
}

cmd_search() {
  [[ -n ${1:-} ]] || die "usage: omani-provider search <query>"
  local page
  page=$(fetch "$BASE_API/search?keyword=$(urlencode "$1")") || exit 1
  parse_search <<<"$page"
}

cmd_episodes() {
  [[ -n ${1:-} ]] || die "usage: omani-provider episodes <anime-id>"
  fetch "$BASE_API/api/theme/episode/list/${1##*-}" | parse_episodes "$1"
}

cmd_stream() {
  local id="${1:-}" episode="${2:-}" mode="${3:-sub}" quality="${4:-best}"
  [[ -n $id && -n $episode ]] || die "usage: omani-provider stream <anime-id> <episode> [sub|dub] [quality]"

  local ep_id
  ep_id=$(cmd_episodes "$id" | episode="$episode" awk -F'\t' '$2 == ENVIRON["episode"] { print $1; exit }')
  [[ -n $ep_id ]] || die "episode $episode not found"

  local servers hash embed
  servers=$(fetch "$BASE_API/api/theme/episode/servers?episodeId=$ep_id" | sed 's|\\"|"|g; s|server-item|\nserver-item|g')
  hash=$(mode="$mode" awk '
    /server-item/ {
      if (attr($0, "data-type") == ENVIRON["mode"]) {
        print attr($0, "data-hash")
        exit
      }
    }
    function attr(line, key,   m) {
      if (!match(line, key "=\"[^\"]*\"")) return ""
      m = substr(line, RSTART, RLENGTH)
      return substr(m, length(key) + 3, length(m) - length(key) - 3)
    }
  ' <<<"$servers")
  [[ -n $hash ]] || die "the site lists no $mode source for this episode"
  embed=$(b64_decode "$hash")
  [[ -n $embed ]] || die "could not decode the embed url"
  [[ $embed == https://* || $embed == http://* ]] || die "not a playable embed: $embed"

  local referrer player json blob opened master subs links url
  referrer=$(sed -E 's|^(https?://[^/]*).*|\1/|' <<<"$embed")
  player=$(fetch "$embed" -e "$BASE_API/" | sed -nE 's|.*data-id="([0-9]+)".*|\1|p' | head -1)
  [[ -n $player ]] || die "the embed page carried no player id"
  json=$(fetch "${referrer}stream/getSources?id=$player" -H 'X-Requested-With: XMLHttpRequest')
  blob=$(jq -r '.enc // empty' <<<"$json" 2>/dev/null)
  [[ -n $blob ]] || die "the sources carried no encrypted playlist"
  opened=$(decrypt_playlist "$blob")
  [[ -n $opened ]] || die "the playlist would not decrypt, so its key has changed"
  master=$(jq -r '.file // empty' <<<"$opened" 2>/dev/null)
  [[ -n $master ]] || die "the playlist named no source"
  [[ $master == https://* || $master == http://* ]] || die "not a playable source: $master"
  # shellcheck disable=SC2016 # the filter is jq's, not the shell's
  subs=$(jq -r 'first(.tracks[]? | select(.default == true) | .file) // empty' <<<"$json" 2>/dev/null)
  [[ $subs == https://* || $subs == http://* ]] || subs=""
  links=$(fetch "$master" -e "$referrer" | parse_qualities "$master")
  [[ -n $links ]] || die "no playable qualities"
  url=$(pick_quality "$quality" "$links")

  printf 'url\t%s\nreferrer\t%s\nsubtitles\t%s\nqualities\t%s\n' \
    "$url" "$referrer" "$subs" "$(heights_of "$links")"
}

usage() {
  cat <<'USAGE'
usage: omani-provider <subcommand>

  search <query>                       id<TAB>title
  episodes <anime-id>                  episode-id<TAB>number
  stream <anime-id> <ep> [mode] [q]    url / referrer / subtitles, one per line

parsers, reading a saved page on stdin:
  parse-search
  parse-episodes <anime-id>
  parse-qualities <master-url>

environment:
  OMANI_BASE_API   provider origin        (default: https://hianime.at)
  OMANI_AGENT      user agent sent with every request
  OMANI_CURL       the curl to use        (default: curl-impersonate, else curl)
USAGE
}

case "${1:-}" in
search)
  shift
  cmd_search "$@"
  ;;
episodes)
  shift
  cmd_episodes "$@"
  ;;
stream)
  shift
  cmd_stream "$@"
  ;;
parse-search) parse_search ;;
parse-episodes)
  shift
  parse_episodes "$@"
  ;;
parse-qualities)
  shift
  parse_qualities "$@"
  ;;
-h | --help) usage ;;
*)
  usage >&2
  exit 1
  ;;
esac
