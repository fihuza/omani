#!/bin/bash

set -uo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PROVIDER="${OMANI_PROVIDER:-$(dirname "$SELF")/omani-provider}"
MANIFEST="${OMANI_MANIFEST:-$(dirname "$(dirname "$SELF")")/manifest.json}"
PLAYER="${OMANI_PLAYER:-mpv}"
PLAYER_RECORD_CAP=20
MPV_SCRIPT_DIRS="${OMANI_MPV_SCRIPT_DIRS:-${XDG_CONFIG_HOME:-$HOME/.config}/mpv/scripts:/etc/mpv/scripts:/usr/lib/mpv-mpris}"
MPV_CONF_FILES="${OMANI_MPV_CONF_FILES:-${MPV_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mpv}/mpv.conf:/etc/mpv/mpv.conf}"

STATE_DIR="${OMANI_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/omani}"
PLAYERS_FILE="$STATE_DIR/players"

HIST_FILE="${OMANI_HIST_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/omani/history.json}"
# An episode this far through counts as seen, so resuming moves on rather than
# landing in the credits.
WATCHED_FRACTION=90

REPLACE="${OMANI_REPLACE:-}"
QUALITY="${OMANI_QUALITY-best}"
MODE="${OMANI_MODE:-sub}"

die() {
  printf 'omani: %s\n' "$1" >&2
  exit 1
}

dry() { [[ -n ${OMANI_DRY_RUN:-} ]]; }

usage() {
  cat <<'USAGE'
usage: omani <subcommand> [args]

  status                              JSON: dependencies and paths
  search <query>                      anime-id<TAB>title
  episodes <anime-id>                 episode-id<TAB>number
  play <anime-id> <title> <episode>   resolve and start playback
  resume <anime-id>                   continue where the series was left off
  next <anime-id>                     play the episode after the one in history
  previous <anime-id>                 play the episode before the one in history
  players                             pid<TAB>title<TAB>anime-id<TAB>episode, live only
  stop [pid|title|anime-id|all]       stop a player this plugin started
  progress <id> <ep> <seconds> <total>  record how far into an episode you are
  history                             print the watch history as json
  forget <anime-id>                   drop one series from the history
  history-clear                       empty the watch history (keeps a backup)

environment:
  OMANI_PLAYER       media player               (default: mpv)
  OMANI_QUALITY      best | worst | 1080 | ...  (empty means best)
  OMANI_MODE         sub | dub
  OMANI_HIST_FILE    watch history (json)
  OMANI_REPLACE      media title of a player to close first
  OMANI_DRY_RUN      non-empty: print what would run instead of running it
  OMANI_PROVIDER     the provider script                (default: bin/omani-provider)
  OMANI_STATE_DIR    where running players are recorded
  OMANI_MANIFEST     manifest.json, for the version
  OMANI_MPV_SCRIPT_DIRS
                     colon-separated dirs searched for mpv's mpris script
  OMANI_MPV_CONF_FILES
                     colon-separated mpv configs read for a script= line
USAGE
}

EMPTY_HISTORY='{"version":1,"series":{}}'

read_history() {
  [[ -f $HIST_FILE ]] && jq -e . "$HIST_FILE" 2>/dev/null || printf '%s\n' "$EMPTY_HISTORY"
}

# Two players report progress every few seconds, and a read-modify-write of the
# whole file loses one of them if they interleave.
update_history() {
  local tmp
  mkdir -p "$(dirname "$HIST_FILE")"
  # Beside the history rather than in TMPDIR: mv only renames within one
  # filesystem, and everything that reads the history takes no lock -- it relies
  # on never being handed half a file.
  tmp=$(mktemp "$HIST_FILE.XXXXXX")
  (
    trap 'rm -f "$tmp"' EXIT
    # Bounded, so a writer that wedges fails the next one instead of queueing
    # players behind it for good.
    flock -w 5 9 || die "could not take the history lock"
    read_history | jq "$@" >"$tmp"
    jq -e . "$tmp" >/dev/null 2>&1 || die "refusing to write a history that is not valid json"
    mv "$tmp" "$HIST_FILE"
  ) 9>"$HIST_FILE.lock"
}

entry_for() {
  read_history | jq -e --arg id "$1" '.series[$id] // empty' 2>/dev/null
}

record_history() {
  local episode="$1" id="$2" title="$3"
  # shellcheck disable=SC2016 # $id and friends are jq variables, bound by --arg
  update_history \
    --arg id "$id" --arg title "$title" --arg episode "$episode" \
    --argjson now "$(date +%s)" '
      .series[$id] = ((.series[$id] // {episodes: {}}) + {
        title: $title,
        episode: $episode,
        updated: $now
      })
    '
}

# Called while a player runs, so the next resume starts where this one stopped.
# Which episode the series is on is not touched here: that belongs to starting
# one and to finishing one, and a report arriving after either would undo it.
record_progress() {
  local id="$1" episode="$2" position="$3" duration="$4"
  [[ $position =~ ^[0-9]+$ && $duration =~ ^[0-9]+$ ]] || die "position and duration must be whole seconds"
  # shellcheck disable=SC2016 # $id and friends are jq variables, bound by --arg
  update_history \
    --arg id "$id" --arg episode "$episode" \
    --argjson position "$position" --argjson duration "$duration" \
    --argjson now "$(date +%s)" '
      (.series[$id] // {title: "", episodes: {}}) as $entry
      | .series[$id] = ($entry + {
          updated: $now,
          episodes: (($entry.episodes // {}) + {
            ($episode): {position: $position, duration: $duration}
          })
        })
    '
}

record_player() {
  local pid="$1" title="$2" id="$3" episode="$4" qualities="${5:-}" tmp
  mkdir -p "$STATE_DIR"
  [[ -f $PLAYERS_FILE ]] || : >"$PLAYERS_FILE"
  tmp=$(mktemp "$PLAYERS_FILE.XXXXXX")
  # A title reaches awk through the environment rather than -v, which expands
  # escape sequences and would mangle a backslash in a series name.
  title="$title" awk -F'\t' 'NF >= 4 && $2 != ENVIRON["title"]' "$PLAYERS_FILE" |
    tail -n "$((PLAYER_RECORD_CAP - 1))" >"$tmp"
  printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$title" "$id" "$episode" "$qualities" >>"$tmp"
  mv "$tmp" "$PLAYERS_FILE"
}

cmd_players() {
  [[ -f $PLAYERS_FILE ]] || return 0
  local pid rest
  while IFS=$'\t' read -r pid rest; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    kill -0 "$pid" 2>/dev/null || continue
    printf '%s\t%s\n' "$pid" "$rest"
  done <"$PLAYERS_FILE"
}

cmd_stop() {
  local target="${1:-all}"
  [[ -f $PLAYERS_FILE ]] || return 0

  local pids
  if [[ $target == "all" ]]; then
    pids=$(cut -f1 "$PLAYERS_FILE")
  else
    # A player is named by its pid, its title or the series it belongs to: only
    # the last of those is known while an episode is being replaced.
    pids=$(target="$target" awk -F'\t' \
      'NF >= 4 && ($1 == ENVIRON["target"] || $2 == ENVIRON["target"] || $3 == ENVIRON["target"]) { print $1 }' "$PLAYERS_FILE")
  fi
  [[ -n $pids ]] || return 0

  if dry; then
    printf 'stop %s\n' "$(tr '\n' ' ' <<<"$pids" | sed 's| *$||')"
    return 0
  fi

  local pid tmp
  for pid in $pids; do
    [[ $pid =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null
  done
  tmp=$(mktemp "$PLAYERS_FILE.XXXXXX")
  awk -F'\t' -v list="$pids" '
    BEGIN { n = split(list, k, "\n"); for (i = 1; i <= n; i++) dead[k[i]] = 1 }
    !dead[$1]
  ' "$PLAYERS_FILE" >"$tmp"
  mv "$tmp" "$PLAYERS_FILE"
}

cmd_play() {
  local id="${1:-}" title="${2:-}" episode="${3:-}" start="${4:-0}"
  [[ -n $id && -n $title && -n $episode ]] || die "usage: omani play <anime-id> <title> <episode> [start-seconds]"
  [[ $start =~ ^[0-9]+$ ]] || die "start must be whole seconds"

  # The player record is tab separated and the title is what matches it to the
  # player on the bus, so the tab goes before mpv is told what to call itself.
  title=${title//$'\t'/ }

  local stream url referrer subtitles
  stream=$("$PROVIDER" stream "$id" "$episode" "$MODE" "${QUALITY:-best}") || die "could not resolve episode $episode"
  url=$(awk -F'\t' '$1 == "url" { print $2 }' <<<"$stream")
  referrer=$(awk -F'\t' '$1 == "referrer" { print $2 }' <<<"$stream")
  subtitles=$(awk -F'\t' '$1 == "subtitles" { print $2 }' <<<"$stream")
  local qualities
  qualities=$(awk -F'\t' '$1 == "qualities" { print $2 }' <<<"$stream")
  [[ -n $url ]] || die "no playable source for episode $episode"

  # Closed before the new one starts, so following a series never leaves two
  # players running.
  [[ -n $REPLACE ]] && cmd_stop "$REPLACE"

  local args=("$PLAYER" "--referrer=$referrer" "--force-media-title=$title Episode $episode")
  [[ -n $subtitles ]] && args+=("--sub-file=$subtitles")
  ((start > 0)) && args+=("--start=$start")
  args+=("$url")

  if dry; then
    printf '%s\n' "${args[*]}"
    return 0
  fi

  mkdir -p "$STATE_DIR"
  # Launched directly rather than through setsid --fork, whose pid belongs to a
  # wrapper that exits at once; the record has to name the player itself or
  # nothing can be listed or stopped. This script is already detached, so the
  # player is reparented when it exits.
  "${args[@]}" </dev/null >/dev/null 2>&1 &
  record_player "$!" "$title Episode $episode" "$id" "$episode" "$qualities"
  disown

  record_history "$episode" "$id" "$title"
}

# Episode numbers are not always contiguous -- specials and recaps sit between
# them -- so what follows or precedes an episode is read from the provider's own
# list rather than counted.
neighbour_episode() {
  local current="$1" side="$2" episodes="$3"
  if [[ $side == after ]]; then
    awk -F'\t' -v w="$current" 'seen { print $2; exit } $2 == w { seen = 1 }' <<<"$episodes"
  else
    awk -F'\t' -v w="$current" '$2 == w { print previous; exit } { previous = $2 }' <<<"$episodes"
  fi
}

# The history holds the episode you are on, so continuing plays that one --
# where you stopped if that is known. Only an episode watched to the end moves
# on to the next.
cmd_resume() {
  local id="${1:-}"
  [[ -n $id ]] || die "usage: omani resume <anime-id>"
  local entry
  entry=$(entry_for "$id") || die "'$id' is not in history"

  local title episode position duration
  title=$(jq -r '.title' <<<"$entry")
  episode=$(jq -r '.episode' <<<"$entry")
  # shellcheck disable=SC2016 # $ep is a jq variable, bound by --arg
  position=$(jq -r --arg ep "$episode" '.episodes[$ep].position // 0' <<<"$entry")
  # shellcheck disable=SC2016 # $ep is a jq variable, bound by --arg
  duration=$(jq -r --arg ep "$episode" '.episodes[$ep].duration // 0' <<<"$entry")

  if ((duration == 0 || position * 100 < duration * WATCHED_FRACTION)); then
    cmd_play "$id" "$title" "$episode" "$position"
    return
  fi

  local episodes next
  episodes=$("$PROVIDER" episodes "$id") || die "could not list episodes for '$title'"
  next=$(neighbour_episode "$episode" after "$episodes")
  [[ -n $next ]] || die "no episode after $episode of $title"

  cmd_play "$id" "$title" "$next"
}

# Next and previous step from the episode the series is on however much of it
# was watched: asking for another episode is the answer, so the one being left
# keeps the progress it had rather than counting as finished.
cmd_step() {
  local side="$1" id="${2:-}"
  local sub=next
  [[ $side == after ]] || sub=previous
  [[ -n $id ]] || die "usage: omani $sub <anime-id>"
  local entry
  entry=$(entry_for "$id") || die "'$id' is not in history"

  local current title episodes target
  current=$(jq -r '.episode' <<<"$entry")
  title=$(jq -r '.title' <<<"$entry")
  episodes=$("$PROVIDER" episodes "$id") || die "could not list episodes for '$title'"
  target=$(neighbour_episode "$current" "$side" "$episodes")
  [[ -n $target ]] || die "no episode $side $current of $title"

  cmd_play "$id" "$title" "$target"
}

# mpv loads scripts from its script directories and from whatever script= or
# scripts-append= lines its config carries, so both are consulted rather than
# assuming the packaged location.
mpris_present() {
  local dir file dirs conf confs
  IFS=: read -ra dirs <<<"$MPV_SCRIPT_DIRS"
  for dir in "${dirs[@]}"; do
    [[ -n $dir ]] || continue
    for file in "$dir"/mpris.*; do
      [[ -e $file ]] && return 0
    done
  done

  IFS=: read -ra confs <<<"$MPV_CONF_FILES"
  for conf in "${confs[@]}"; do
    [[ -n $conf && -f $conf ]] || continue
    grep -qE '^[[:space:]]*scripts?(-append)?[[:space:]]*=.*mpris' "$conf" && return 0
  done
  return 1
}

cmd_status() {
  local missing=()
  command -v "$PLAYER" >/dev/null || missing+=("$PLAYER")
  command -v curl >/dev/null || command -v curl_chrome136 >/dev/null || missing+=(curl)
  local version=""
  [[ -f $MANIFEST ]] && version=$(jq -r '.version // ""' "$MANIFEST" 2>/dev/null)

  jq -n \
    --arg version "$version" \
    --argjson ready "$( ((${#missing[@]} == 0)) && echo true || echo false)" \
    --argjson watchedFraction "$WATCHED_FRACTION" \
    --argjson tracking "$(mpris_present && echo true || echo false)" \
    --arg missing "${missing[*]:-}" \
    --arg historyPath "$HIST_FILE" \
    --arg playersPath "$PLAYERS_FILE" \
    '{ready: $ready, tracking: $tracking, watchedFraction: $watchedFraction, version: $version, missing: $missing, historyPath: $historyPath, playersPath: $playersPath}'
}

# Finishing an episode moves the series on, so what the panel offers to
# continue is the episode that would actually play. The lookup happens once,
# when the threshold is crossed, not on every report.
advance_past() {
  local id="$1" episode="$2" episodes next
  episodes=$("$PROVIDER" episodes "$id" 2>/dev/null) || return 0
  next=$(neighbour_episode "$episode" after "$episodes")
  [[ -n $next ]] || return 0
  # shellcheck disable=SC2016 # $id and $next are jq variables, bound by --arg
  update_history --arg id "$id" --arg next "$next" '.series[$id].episode = $next'
}

cmd_progress() {
  local id="${1:-}" episode="${2:-}" position="${3:-}" duration="${4:-}"
  [[ -n $id && -n $episode && -n $position && -n $duration ]] ||
    die "usage: omani progress <anime-id> <episode> <position-seconds> <duration-seconds>"
  local entry
  entry=$(entry_for "$id") || die "'$id' is not in history"
  if dry; then
    printf 'progress %s %s %s %s\n' "$id" "$episode" "$position" "$duration"
    return 0
  fi
  record_progress "$id" "$episode" "$position" "$duration"

  local current
  current=$(jq -r '.episode' <<<"$entry")
  if [[ $current == "$episode" ]] && ((duration > 0 && position * 100 >= duration * WATCHED_FRACTION)); then
    advance_past "$id" "$episode"
  fi
}

cmd_forget() {
  local id="${1:-}"
  [[ -n $id ]] || die "usage: omani forget <anime-id>"
  entry_for "$id" >/dev/null || die "'$id' is not in history"
  if dry; then
    printf 'forget %s\n' "$id"
    return 0
  fi
  # shellcheck disable=SC2016 # $id is a jq variable, bound by --arg
  update_history --arg id "$id" 'del(.series[$id])'
}

cmd_history_clear() {
  [[ -f $HIST_FILE ]] || return 0
  if dry; then
    printf 'truncate %s\n' "$HIST_FILE"
    return 0
  fi
  cp "$HIST_FILE" "$HIST_FILE.bak"
  update_history '{version: 1, series: {}}'
}

main() {
  local sub="${1:-}"
  (($# > 0)) && shift

  case "$sub" in
  status) cmd_status ;;
  search) "$PROVIDER" search "$@" ;;
  episodes) "$PROVIDER" episodes "$@" ;;
  play) cmd_play "$@" ;;
  resume) cmd_resume "$@" ;;
  next) cmd_step after "$@" ;;
  previous) cmd_step before "$@" ;;
  stop) cmd_stop "$@" ;;
  players) cmd_players ;;
  progress) cmd_progress "$@" ;;
  history) read_history ;;
  forget) cmd_forget "$@" ;;
  history-clear) cmd_history_clear ;;
  -h | --help | help) usage ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    printf 'omani: unknown subcommand %s\n\n' "$sub" >&2
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"
