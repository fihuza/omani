#!/bin/bash

set -uo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PROVIDER="${OMANI_PROVIDER:-$(dirname "$SELF")/omani-provider}"
MANIFEST="${OMANI_MANIFEST:-$(dirname "$(dirname "$SELF")")/manifest.json}"
PLAYER="${OMANI_PLAYER:-mpv}"
REPO="https://github.com/fihuza/omani"
PLAYER_RECORD_CAP=20
MPV_SCRIPT_DIRS="${OMANI_MPV_SCRIPT_DIRS:-${XDG_CONFIG_HOME:-$HOME/.config}/mpv/scripts:/etc/mpv/scripts:/usr/lib/mpv-mpris}"
MPV_CONF_FILES="${OMANI_MPV_CONF_FILES:-${MPV_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mpv}/mpv.conf:/etc/mpv/mpv.conf}"

STATE_DIR="${OMANI_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/omani}"
PLAYERS_FILE="$STATE_DIR/players"

HIST_FILE="${OMANI_HIST_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/omani/history.json}"
WATCHED_FRACTION="${OMANI_WATCHED_FRACTION:-90}"
[[ $WATCHED_FRACTION =~ ^([1-9][0-9]?|100)$ ]] || WATCHED_FRACTION=90

QUALITY="${OMANI_QUALITY-best}"
MODE="${OMANI_MODE:-sub}"

die() {
  printf 'omani: %s\n' "$1" >&2
  exit 1
}

dry() { [[ -n ${OMANI_DRY_RUN:-} ]]; }

usage() {
  cat <<'USAGE'
usage: omani <subcommand> [args]

  status                              JSON: dependencies and paths
  search <query>                      anime-id<TAB>title
  episodes <anime-id>                 episode-id<TAB>number
  play <id> <title> <episode> [start]  play it, from [start] or where it was left
  resume <anime-id>                   continue where the series was left off
  next <anime-id>                     play the episode after the one in history
  previous <anime-id>                 play the episode before the one in history
  players                             pid<TAB>title<TAB>anime-id<TAB>episode, live only
  stop [pid|title|anime-id|all]       stop a player this plugin started
  progress <id> <ep> <seconds> <total>  record how far into an episode you are
  history                             print the watch history as json
  forget <anime-id>                   drop one series from the history
  history-clear                       empty the watch history (keeps a backup)

environment:
  OMANI_PLAYER       media player               (default: mpv)
  OMANI_QUALITY      best | worst | 1080 | ...  (empty means best)
  OMANI_MODE         sub | dub
  OMANI_WATCHED_FRACTION
                     percent of an episode that counts as watched (default: 90)
  OMANI_HIST_FILE    watch history (json)
  OMANI_DRY_RUN      non-empty: print what would run instead of running it
  OMANI_PROVIDER     the provider script                (default: bin/omani-provider)
  OMANI_STATE_DIR    where running players are recorded
  OMANI_MANIFEST     manifest.json, for the version
  OMANI_MPV_SCRIPT_DIRS
                     colon-separated dirs searched for mpv's mpris script
  OMANI_MPV_CONF_FILES
                     colon-separated mpv configs read for a script= line
USAGE
}

EMPTY_HISTORY='{"version":1,"series":{}}'

history_parses() {
  [[ -f $HIST_FILE ]] && jq -e . "$HIST_FILE" >/dev/null 2>&1
}

read_history() {
  if history_parses; then
    jq -e . "$HIST_FILE"
  else
    printf '%s\n' "$EMPTY_HISTORY"
  fi
}

update_history() {
  local tmp dir
  [[ -f $HIST_FILE ]] && ! history_parses &&
    die "refusing to write over a history that is not valid json: $HIST_FILE"
  dir=$(dirname "$HIST_FILE")
  mkdir -p "$dir" 2>/dev/null
  tmp=$(mktemp "$HIST_FILE.XXXXXX" 2>/dev/null) || die "cannot write the history in $dir"
  (
    trap 'rm -f "$tmp"' EXIT
    flock -w 5 9 || die "could not take the history lock"
    read_history | jq "$@" >"$tmp" 2>/dev/null
    jq -e . "$tmp" >/dev/null 2>&1 || die "refusing to write a history that is not valid json"
    mv "$tmp" "$HIST_FILE"
  ) 9>"$HIST_FILE.lock"
}

entry_for() {
  read_history | jq -e --arg id "$1" '.series[$id] | objects' 2>/dev/null
}

series_has() {
  read_history | jq -e --arg id "$1" '(.series // {}) | has($id)' >/dev/null 2>&1
}

record_history() {
  local episode="$1" id="$2" title="$3"
  # shellcheck disable=SC2016 # $id and friends are jq variables, bound by --arg
  update_history \
    --arg id "$id" --arg title "$title" --arg episode "$episode" \
    --argjson now "$(date +%s%3N)" '
      .series[$id] = ((.series[$id] // {episodes: {}}) + {
        title: $title,
        episode: $episode,
        updated: $now
      })
    '
}

record_progress() {
  local id="$1" episode="$2" position="$3" duration="$4"
  [[ $position =~ ^[0-9]+$ && $duration =~ ^[0-9]+$ ]] || die "position and duration must be whole seconds"
  # shellcheck disable=SC2016 # $id and friends are jq variables, bound by --arg
  update_history \
    --arg id "$id" --arg episode "$episode" \
    --argjson position "$position" --argjson duration "$duration" \
    --argjson now "$(date +%s%3N)" '
      if (.series[$id] | type) != "object" then . else
        .series[$id] as $entry
        | .series[$id] = ($entry + {
            updated: $now,
            episodes: (($entry.episodes | objects // {}) + {
              ($episode): {position: $position, duration: $duration}
            })
          })
      end
    '
}

players_tmp() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  [[ -f $PLAYERS_FILE ]] || : >"$PLAYERS_FILE" 2>/dev/null
  mktemp "$PLAYERS_FILE.XXXXXX" 2>/dev/null
}

record_player() {
  local pid="$1" title="$2" id="$3" episode="$4" qualities="${5:-}" started="${6:-}" tmp
  tmp=$(players_tmp) || die "cannot write the player list in $STATE_DIR"
  (
    trap 'rm -f "$tmp"' EXIT
    title="$title" awk -F'\t' 'NF >= 4 && $2 != ENVIRON["title"]' "$PLAYERS_FILE" |
      tail -n "$((PLAYER_RECORD_CAP - 1))" >"$tmp"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$pid" "$title" "$id" "$episode" "$qualities" "$started" >>"$tmp"
    mv "$tmp" "$PLAYERS_FILE"
  )
}

playing_episode() {
  cmd_players | id="$1" awk -F'\t' '$3 == ENVIRON["id"] { latest = $4 } END { if (latest != "") print latest }'
}

read_started_at() {
  local stat fields
  STARTED_AT=""
  { read -r stat <"/proc/$1/stat"; } 2>/dev/null || return 0
  stat=${stat#*") "}
  # shellcheck disable=SC2206 # the stat line is split on its own spaces
  fields=($stat)
  [[ ${fields[0]} == Z ]] && return 0
  STARTED_AT=${fields[19]}
}

split_record() {
  local line=$1
  RECORD=()
  while [[ $line == *$'\t'* ]]; do
    RECORD+=("${line%%$'\t'*}")
    line=${line#*$'\t'}
  done
  RECORD+=("$line")
}

cmd_players() {
  [[ -f $PLAYERS_FILE ]] || return 0
  local line
  while IFS= read -r line; do
    split_record "$line"
    [[ ${RECORD[0]:-} =~ ^[0-9]+$ && -n ${RECORD[1]:-} && -n ${RECORD[2]:-} && -n ${RECORD[3]:-} ]] || continue
    read_started_at "${RECORD[0]}"
    [[ -n $STARTED_AT ]] || continue
    [[ -n ${RECORD[5]:-} && ${RECORD[5]} != "$STARTED_AT" ]] && continue
    printf '%s\t%s\t%s\t%s\t%s\n' "${RECORD[0]}" "${RECORD[1]}" "${RECORD[2]}" "${RECORD[3]}" "${RECORD[4]:-}"
  done <"$PLAYERS_FILE"
}

process_gone() {
  read_started_at "$1"
  [[ -z $STARTED_AT ]]
}

end_players() {
  local pid waited=0 alive
  while ((waited < 40)); do
    alive=""
    for pid in $1; do
      process_gone "$pid" || alive=yes
    done
    [[ -z $alive ]] && return 0
    if ((waited == 20)); then
      for pid in $1; do
        process_gone "$pid" || kill -9 "$pid" 2>/dev/null
      done
    fi
    sleep 0.05
    waited=$((waited + 1))
  done
}

cmd_stop() {
  local target="${1:-all}"

  local live pids
  live=$(cmd_players)
  if [[ $target == "all" ]]; then
    pids=$(cut -f1 <<<"$live")
  else
    pids=$(target="$target" awk -F'\t' \
      'NF >= 4 && ($1 == ENVIRON["target"] || $2 == ENVIRON["target"] || $3 == ENVIRON["target"]) { print $1 }' <<<"$live")
  fi
  [[ -n $pids ]] || return 0

  if dry; then
    printf 'stop %s\n' "$(tr '\n' ' ' <<<"$pids" | sed 's| *$||')"
    return 0
  fi

  local pid tmp gone=""
  for pid in $pids; do
    [[ $pid =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null
  done
  end_players "$pids"
  for pid in $pids; do
    process_gone "$pid" && gone+="$pid"$'\n'
  done
  tmp=$(players_tmp) || die "cannot write the player list in $STATE_DIR"
  (
    trap 'rm -f "$tmp"' EXIT
    list="$gone" awk -F'\t' '
      BEGIN { n = split(ENVIRON["list"], k, "\n"); for (i = 1; i <= n; i++) dead[k[i]] = 1 }
      !dead[$1]
    ' "$PLAYERS_FILE" >"$tmp"
    mv "$tmp" "$PLAYERS_FILE"
  )
}

cmd_play() {
  local id="${1:-}" title="${2:-}" episode="${3:-}" start="${4:-}"
  [[ -n $id && -n $title && -n $episode ]] || die "usage: omani play <anime-id> <title> <episode> [start-seconds]"
  [[ -n $start ]] || start=$(episode_start "$(entry_for "$id" || printf '{}')" "$episode")
  [[ $start =~ ^[0-9]+$ ]] || die "start must be whole seconds"

  title=${title//$'\t'/ }
  title=${title//$'\n'/ }

  local stream url referrer subtitles
  stream=$("$PROVIDER" stream "$id" "$episode" "$MODE" "${QUALITY:-best}") || die "could not resolve episode $episode"
  url=$(awk -F'\t' '$1 == "url" { print $2 }' <<<"$stream")
  referrer=$(awk -F'\t' '$1 == "referrer" { print $2 }' <<<"$stream")
  subtitles=$(awk -F'\t' '$1 == "subtitles" { print $2 }' <<<"$stream")
  local qualities
  qualities=$(awk -F'\t' '$1 == "qualities" { print $2 }' <<<"$stream")
  [[ -n $url ]] || die "no playable source for episode $episode"
  [[ $url == https://* || $url == http://* ]] || die "not a playable source: $url"
  [[ -z $subtitles || $subtitles == https://* || $subtitles == http://* ]] || subtitles=""

  cmd_stop "$id"

  local args=("$PLAYER" "--referrer=$referrer" "--force-media-title=$title Episode $episode")
  [[ -n $subtitles ]] && args+=("--sub-file=$subtitles")
  ((start > 0)) && args+=("--start=$start")
  args+=(-- "$url")

  if dry; then
    printf '%s\n' "${args[*]}"
    return 0
  fi

  "${args[@]}" </dev/null >/dev/null 2>&1 &
  read_started_at "$!"
  record_player "$!" "$title Episode $episode" "$id" "$episode" "$qualities" "$STARTED_AT"
  # A player that exits before this line leaves no job to disown, and bash says
  # so on stderr.
  disown 2>/dev/null || true

  record_history "$episode" "$id" "$title"
}

neighbour_episode() {
  local current="$1" side="$2" episodes="$3"
  if [[ $side == after ]]; then
    current="$current" awk -F'\t' 'seen { print $2; exit } $2 == ENVIRON["current"] { seen = 1 }' <<<"$episodes"
  else
    current="$current" awk -F'\t' '$2 == ENVIRON["current"] { print previous; exit } { previous = $2 }' <<<"$episodes"
  fi
}

episode_field() {
  # shellcheck disable=SC2016 # $ep and $f are jq variables, bound by --arg
  jq -r --arg ep "$2" --arg f "$3" '((.episodes? // {})[$ep]?[$f]? | numbers) // 0' <<<"$1"
}

seconds_or_zero() {
  [[ $1 =~ ^[0-9]+$ ]] && printf '%s\n' "$1" && return 0
  printf '0\n'
}

episode_watched() {
  local position duration
  position=$(seconds_or_zero "$(episode_field "$1" "$2" position)")
  duration=$(seconds_or_zero "$(episode_field "$1" "$2" duration)")
  ((duration > 0 && position * 100 >= duration * WATCHED_FRACTION))
}

episode_start() {
  episode_watched "$1" "$2" && printf '0\n' && return 0
  seconds_or_zero "$(episode_field "$1" "$2" position)"
}

cmd_resume() {
  local id="${1:-}"
  [[ -n $id ]] || die "usage: omani resume <anime-id>"
  local entry
  entry=$(entry_for "$id") || die "'$id' is not in history"

  local title episode
  title=$(jq -r '.title' <<<"$entry")
  episode=$(jq -r '.episode' <<<"$entry")

  if ! episode_watched "$entry" "$episode"; then
    cmd_play "$id" "$title" "$episode" "$(episode_start "$entry" "$episode")"
    return
  fi

  local episodes next
  episodes=$("$PROVIDER" episodes "$id") || die "could not list episodes for '$title'"
  next=$(neighbour_episode "$episode" after "$episodes")
  [[ -n $next ]] || die "no episode after $episode of $title"

  cmd_play "$id" "$title" "$next"
}

cmd_step() {
  local side="$1" id="${2:-}"
  local sub=next
  [[ $side == after ]] || sub=previous
  [[ -n $id ]] || die "usage: omani $sub <anime-id>"
  local entry
  entry=$(entry_for "$id") || die "'$id' is not in history"

  local current title episodes target
  current=$(playing_episode "$id")
  [[ -n $current ]] || current=$(jq -r '.episode' <<<"$entry")
  title=$(jq -r '.title' <<<"$entry")
  episodes=$("$PROVIDER" episodes "$id") || die "could not list episodes for '$title'"
  target=$(neighbour_episode "$current" "$side" "$episodes")
  [[ -n $target ]] || die "no episode $side $current of $title"

  cmd_play "$id" "$title" "$target" "$(episode_start "$entry" "$target")"
}

mpris_present() {
  local dir file dirs conf confs
  IFS=: read -ra dirs <<<"$MPV_SCRIPT_DIRS"
  for dir in "${dirs[@]}"; do
    [[ -n $dir ]] || continue
    for file in "$dir"/mpris.*; do
      [[ -e $file ]] && return 0
    done
  done

  IFS=: read -ra confs <<<"$MPV_CONF_FILES"
  for conf in "${confs[@]}"; do
    [[ -n $conf && -f $conf ]] || continue
    grep -qE '^[[:space:]]*scripts?(-append)?[[:space:]]*=.*mpris' "$conf" && return 0
  done
  return 1
}

cmd_status() {
  local missing=()
  command -v "$PLAYER" >/dev/null || missing+=("$PLAYER")
  command -v curl >/dev/null || command -v curl_chrome136 >/dev/null || missing+=(curl)
  local version=""
  [[ -f $MANIFEST ]] && version=$(jq -r '.version // ""' "$MANIFEST" 2>/dev/null)

  jq -n \
    --arg version "$version" \
    --arg repo "$REPO" \
    --argjson ready "$( ((${#missing[@]} == 0)) && echo true || echo false)" \
    --argjson watchedFraction "$WATCHED_FRACTION" \
    --argjson tracking "$(mpris_present && echo true || echo false)" \
    --arg missing "${missing[*]:-}" \
    --arg historyPath "$HIST_FILE" \
    --arg playersPath "$PLAYERS_FILE" \
    '{ready: $ready, tracking: $tracking, watchedFraction: $watchedFraction, version: $version, repo: $repo, missing: $missing, historyPath: $historyPath, playersPath: $playersPath}'
}

advance_past() {
  local id="$1" episode="$2" episodes next
  episodes=$("$PROVIDER" episodes "$id" 2>/dev/null) || return 0
  next=$(neighbour_episode "$episode" after "$episodes")
  [[ -n $next ]] || return 0
  # shellcheck disable=SC2016 # $id and $next are jq variables, bound by --arg
  update_history --arg id "$id" --arg next "$next" '.series[$id].episode = $next'
}

cmd_progress() {
  local id="${1:-}" episode="${2:-}" position="${3:-}" duration="${4:-}"
  [[ -n $id && -n $episode && -n $position && -n $duration ]] ||
    die "usage: omani progress <anime-id> <episode> <position-seconds> <duration-seconds>"
  local entry
  entry=$(entry_for "$id") || die "'$id' is not in history"
  if dry; then
    printf 'progress %s %s %s %s\n' "$id" "$episode" "$position" "$duration"
    return 0
  fi
  record_progress "$id" "$episode" "$position" "$duration"

  local current
  current=$(jq -r '.episode' <<<"$entry")
  if [[ $current == "$episode" ]] && ((duration > 0 && position * 100 >= duration * WATCHED_FRACTION)); then
    advance_past "$id" "$episode"
  fi
}

cmd_forget() {
  local id="${1:-}"
  [[ -n $id ]] || die "usage: omani forget <anime-id>"
  series_has "$id" || die "'$id' is not in history"
  if dry; then
    printf 'forget %s\n' "$id"
    return 0
  fi
  # shellcheck disable=SC2016 # $id is a jq variable, bound by --arg
  update_history --arg id "$id" 'del(.series[$id])'
}

cmd_history_clear() {
  [[ -f $HIST_FILE ]] || return 0
  if dry; then
    printf 'truncate %s\n' "$HIST_FILE"
    return 0
  fi
  cp "$HIST_FILE" "$HIST_FILE.bak" 2>/dev/null ||
    die "refusing to clear a history that cannot be backed up: $HIST_FILE.bak"
  update_history '{version: 1, series: {}}'
}

main() {
  local sub="${1:-}"
  (($# > 0)) && shift

  case "$sub" in
  status) cmd_status ;;
  search) "$PROVIDER" search "$@" ;;
  episodes) "$PROVIDER" episodes "$@" ;;
  play) cmd_play "$@" ;;
  resume) cmd_resume "$@" ;;
  next) cmd_step after "$@" ;;
  previous) cmd_step before "$@" ;;
  stop) cmd_stop "$@" ;;
  players) cmd_players ;;
  progress) cmd_progress "$@" ;;
  history) read_history ;;
  forget) cmd_forget "$@" ;;
  history-clear) cmd_history_clear ;;
  -h | --help | help) usage ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    printf 'omani: unknown subcommand %s\n\n' "$sub" >&2
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"
