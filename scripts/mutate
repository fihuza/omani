#!/bin/bash

set -uo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TARGET="${1:-all}"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

total=0
survived=0
survivors=""
model_failed=0
view_failed=0

die() {
  printf 'mutate: %s\n' "$1" >&2
  exit 2
}

qt6_tool() {
  local name=$1 candidate
  for candidate in "/usr/lib/qt6/bin/$name" "/usr/lib/qt6/$name" "$name-qt6"; do
    if command -v "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  if command -v "$name" >/dev/null && "$name" --version 2>&1 | grep -q ' 6\.'; then
    printf '%s\n' "$name"
    return 0
  fi
  return 1
}

green_before_mutating() {
  local room=$1 what=$2 command=$3 where
  where=$WORK/$room
  [[ $room != . ]] || where=$ROOT
  (cd "$where" && eval "$command" >/dev/null 2>&1) ||
    die "$what does not pass before anything is mutated, so every mutant would count as killed"
}

trimmed() {
  local text=${1#"${1%%[![:space:]]*}"}
  printf '%s' "${text:0:64}"
}

ACCOUNTED="$ROOT/tests/mutation-equivalents.tsv"
explained=0
explained_keys=""

accounted_for() {
  [[ -f $ACCOUNTED ]] || return 1
  awk -F'\t' -v f="$1" -v l="$2" -v s="$3" \
    '$1 == f && $2 == l && $3 == s { hit = 1 } END { exit hit ? 0 : 1 }' "$ACCOUNTED"
}

record() {
  local file=$1 line=$2 label=$3 src trim
  src=$4
  trim=$(trimmed "$src")
  if accounted_for "$file" "$label" "$trim"; then
    explained=$((explained + 1))
    explained_keys+="$file"$'\t'"$label"$'\t'"$trim"$'\n'
    return
  fi
  survivors+="  $file:$line  $label    $trim"$'\n'
  survived=$((survived + 1))
}

SHELL_TESTS="bash tests/omani-test.sh && bash tests/provider-test.sh"

shell_noticed() {
  (cd "$WORK/shell" && eval "$SHELL_TESTS" >/dev/null 2>&1)
}

try_shell_mutant() {
  local script=$1 line=$2 label=$3 text=$4
  printf '%s\n' "$text" >"$WORK/shell/$script"
  chmod +x "$WORK/shell/$script"
  bash -n "$WORK/shell/$script" 2>/dev/null || return 0
  total=$((total + 1))
  if shell_noticed; then
    record "$script" "$line" "$label" "$(sed -n "${line}p" "$ROOT/$script")"
  fi
}

shell_layer() {
  local script=$1 line src pair from to mutated total_lines text
  local pairs
  cp -r "$ROOT" "$WORK/shell"
  green_before_mutating shell "the shell suite" "$SHELL_TESTS"

  mapfile -t LINES < <(grep -nE '\|\| (die|return)' "$ROOT/$script" | cut -d: -f1)
  for line in "${LINES[@]}"; do
    try_shell_mutant "$script" "$line" "refusal removed" "$(sed "${line}s/.*/:/" "$ROOT/$script")"
  done

  total_lines=$(wc -l <"$ROOT/$script")
  for ((line = 1; line <= total_lines; line++)); do
    src=$(sed -n "${line}p" "$ROOT/$script")
    [[ ${src#"${src%%[![:space:]]*}"} != \#* ]] || continue
    pairs=('&&:||' '||:&&' ' == : != ' ' != : == ' ' -z : -n ' ' -n : -z ' ' -f : -e ' ' -d : -e ')
    [[ $src != *'(('* ]] || pairs+=(' < : <= ' ' > : >= ' ' >= : > ' ' <= : < ')
    for pair in "${pairs[@]}"; do
      from=${pair%%:*}
      to=${pair##*:}
      [[ $src == *"$from"* ]] || continue
      mutated=${src/"$from"/"$to"}
      [[ $mutated != "$src" ]] || continue
      text=$(mutant="$mutated" awk -v n="$line" 'NR==n{print ENVIRON["mutant"]; next}{print}' "$ROOT/$script")
      try_shell_mutant "$script" "$line" "$from ->$to" "$text"
    done
  done

  cp "$ROOT/$script" "$WORK/shell/$script"
}

if [[ $TARGET == shell ]]; then
  QMLTESTRUNNER=""
else
  QMLTESTRUNNER=$(qt6_tool qmltestrunner) || die "no Qt6 qmltestrunner -- needs the qt6-declarative package"
fi
QML_TESTS="QT_QPA_PLATFORM=offscreen $QMLTESTRUNNER -input tests/qml -import tests/qml/stubs"
pure_layer() {
  command -v stryker >/dev/null || die "no stryker -- run under mise, which pins it"
  green_before_mutating . "the model suite" "node --test 'tests/*.test.js'"
  green_before_mutating . "the model in Qt's engine" "$QML_TESTS"
  (cd "$ROOT" && stryker run) || model_failed=1
}

view_layer() {
  command -v qmutant >/dev/null || die "no qmutant -- run under mise, which pins it"
  local -a workers=()
  [[ -z ${QMUTANT_JOBS:-} ]] || workers=(-j "$QMUTANT_JOBS")
  (cd "$ROOT" && PATH="$(dirname "$QMLTESTRUNNER"):$PATH" qmutant run "${workers[@]}") || view_failed=1
}

[[ $TARGET == all || $TARGET == model ]] && pure_layer
[[ $TARGET == all || $TARGET == qml ]] && view_layer
[[ $TARGET == all || $TARGET == shell ]] && shell_layer bin/omani
[[ $TARGET == all || $TARGET == shell ]] && shell_layer bin/omani-provider

stale=""
if [[ -f $ACCOUNTED ]]; then
  while IFS= read -r entry; do
    [[ -n $entry && $entry != \#* ]] || continue
    grep -Fqx "$entry" <<<"${explained_keys%$'\n'}" ||
      stale+="  ${entry%%$'\t'*} -- $(cut -f2 <<<"$entry")"$'\n'
  done < <(cut -f1-3 "$ACCOUNTED")
fi

((total == 0)) || printf 'guards removed: %d   noticed: %d   survived: %d   explained: %d\n' \
  "$total" "$((total - survived - explained))" "$survived" "$explained"
[[ -n $survivors ]] && printf '\nsurvivors nothing accounts for:\n%s' "$survivors"
[[ -n $stale ]] && printf '\nno longer survive, so their entry has outlived the code:\n%s' "$stale"
[[ -z $survivors && -z $stale ]] && ((model_failed == 0)) && ((view_failed == 0))
