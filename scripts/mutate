#!/bin/bash

set -uo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TARGET="${1:-all}"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

total=0
survived=0
skipped=0
survivors=""

die() {
  printf 'mutate: %s\n' "$1" >&2
  exit 2
}

qt6_tool() {
  local name=$1 candidate
  for candidate in "/usr/lib/qt6/bin/$name" "/usr/lib/qt6/$name" "$name-qt6"; do
    if command -v "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  if command -v "$name" >/dev/null && "$name" --version 2>&1 | grep -q ' 6\.'; then
    printf '%s\n' "$name"
    return 0
  fi
  return 1
}

green_before_mutating() {
  local room=$1 what=$2 command=$3
  (cd "$WORK/$room" && eval "$command" >/dev/null 2>&1) ||
    die "$what does not pass before anything is mutated, so every mutant would count as killed"
}

trimmed() {
  local text=${1#"${1%%[![:space:]]*}"}
  printf '%s' "${text:0:64}"
}

ACCOUNTED="$ROOT/tests/mutation-equivalents.tsv"
explained=0
explained_keys=""

accounted_for() {
  [[ -f $ACCOUNTED ]] || return 1
  awk -F'\t' -v f="$1" -v l="$2" -v s="$3" \
    '$1 == f && $2 == l && $3 == s { hit = 1 } END { exit hit ? 0 : 1 }' "$ACCOUNTED"
}

record() {
  local file=$1 line=$2 label=$3 src trim
  src=$4
  trim=$(trimmed "$src")
  if accounted_for "$file" "$label" "$trim"; then
    explained=$((explained + 1))
    explained_keys+="$file"$'\t'"$label"$'\t'"$trim"$'\n'
    return
  fi
  survivors+="  $file:$line  $label    $trim"$'\n'
  survived=$((survived + 1))
}

worth_mutating() {
  local text=${1#"${1%%[![:space:]]*}"}
  [[ -n $text ]] || return 1
  [[ $text != //* ]] || return 1
  [[ $text != import\ * ]] || return 1
  [[ $text != pragma\ * ]] || return 1
}

swap() {
  local src=$1 pattern=$2 replacement=$3
  sed -E "0,/$pattern/s//$replacement/" <<<"$src"
}

mutants_for() {
  local src=$1 dialect=$2 from to pair mutated
  local pairs=('===:!==' '!==:===' '&&:||' '||:&&' '<=:<' '>=:>')
  [[ $dialect == js ]] && pairs+=('+ 1:- 1' '- 1:+ 1')

  for pair in "${pairs[@]}"; do
    from=${pair%%:*}
    to=${pair##*:}
    [[ $src == *"$from"* ]] || continue
    mutated=${src/"$from"/"$to"}
    [[ $mutated == "$src" ]] && continue
    printf '%s -> %s\t%s\n' "$from" "$to" "$mutated"
  done

  mutated=$(swap "$src" '\btrue\b' 'false')
  [[ $mutated != "$src" ]] && printf 'true -> false\t%s\n' "$mutated"
  mutated=$(swap "$src" '\bfalse\b' 'true')
  [[ $mutated != "$src" ]] && printf 'false -> true\t%s\n' "$mutated"

  mutated=$(swap "$src" '([^=<>!-])<([^=<])' '\1<=\2')
  [[ $mutated != "$src" ]] && printf '< -> <=\t%s\n' "$mutated"
  mutated=$(swap "$src" '([^=<>!-])>([^=>])' '\1>=\2')
  [[ $mutated != "$src" ]] && printf '> -> >=\t%s\n' "$mutated"

  if [[ $src =~ ^([[:space:]]*)return[[:space:]]+(.+)$ && ${BASH_REMATCH[2]} != null* ]]; then
    printf 'return -> null\t%sreturn null;\n' "${BASH_REMATCH[1]}"
  fi

  mutated=$(swap "$src" '"[^"]+"' '""')
  [[ $mutated != "$src" ]] && printf 'string -> empty\t%s\n' "$mutated"
}

still_parses() {
  case "$2" in
  js) node --check "$1" >/dev/null 2>&1 ;;
  qml) qmlformat "$1" >/dev/null 2>&1 ;;
  esac
}

mutate_file() {
  local file=$1 dialect=$2 room=$3 verdict=$4 second=${5:-}
  local line src label mutant total_lines
  cp -r "$ROOT" "$WORK/$room"
  green_before_mutating "$room" "the suite for $file" "$verdict"
  [[ -z $second ]] || green_before_mutating "$room" "the second opinion for $file" "$second"
  total_lines=$(wc -l <"$ROOT/$file")
  for ((line = 1; line <= total_lines; line++)); do
    src=$(sed -n "${line}p" "$ROOT/$file")
    worth_mutating "$src" || continue
    while IFS=$'\t' read -r label mutant; do
      [[ -n $label ]] || continue
      mutant="$mutant" awk -v n="$line" 'NR==n{print ENVIRON["mutant"]; next}{print}' "$ROOT/$file" >"$WORK/$room/$file"
      if ! still_parses "$WORK/$room/$file" "$dialect"; then
        skipped=$((skipped + 1))
        continue
      fi
      total=$((total + 1))
      (cd "$WORK/$room" && eval "$verdict" >/dev/null 2>&1) || continue
      if [[ -n $second ]]; then
        (cd "$WORK/$room" && eval "$second" >/dev/null 2>&1) || continue
      fi
      record "$file" "$line" "$label" "$src"
    done < <(mutants_for "$src" "$dialect")
  done
  cp "$ROOT/$file" "$WORK/$room/$file"
}

refusals() {
  local script=$1 line
  cp -r "$ROOT" "$WORK/shell"
  green_before_mutating shell "the shell suite" "bash tests/omani-test.sh && bash tests/provider-test.sh"
  mapfile -t LINES < <(grep -nE '\|\| (die|return)' "$ROOT/$script" | cut -d: -f1)
  for line in "${LINES[@]}"; do
    sed "${line}s/.*/:/" "$ROOT/$script" >"$WORK/shell/$script"
    chmod +x "$WORK/shell/$script"
    total=$((total + 1))
    if (cd "$WORK/shell" && bash tests/omani-test.sh >/dev/null 2>&1 && bash tests/provider-test.sh >/dev/null 2>&1); then
      record "$script" "$line" "guard removed" "$(sed -n "${line}p" "$ROOT/$script")"
    fi
  done
  cp "$ROOT/$script" "$WORK/shell/$script"
}

QMLTESTRUNNER=$(qt6_tool qmltestrunner) || die "no Qt6 qmltestrunner -- needs the qt6-declarative package"
QML_TESTS="QT_QPA_PLATFORM=offscreen $QMLTESTRUNNER -input tests/qml -import tests/qml/stubs"
MODEL_TESTS="node --test 'tests/*.test.js'"

[[ $TARGET == all || $TARGET == model ]] && mutate_file Model.js js pure "$MODEL_TESTS" "$QML_TESTS"
[[ $TARGET == all || $TARGET == qml ]] && mutate_file Service.qml qml qml "$QML_TESTS"
[[ $TARGET == all || $TARGET == qml ]] && mutate_file Panel.qml qml qml "$QML_TESTS"
[[ $TARGET == all || $TARGET == shell ]] && refusals bin/omani
[[ $TARGET == all || $TARGET == shell ]] && refusals bin/omani-provider

stale=""
if [[ -f $ACCOUNTED ]]; then
  while IFS= read -r entry; do
    [[ -n $entry && $entry != \#* ]] || continue
    grep -Fqx "$entry" <<<"${explained_keys%$'\n'}" ||
      stale+="  ${entry%%$'\t'*} -- $(cut -f2 <<<"$entry")"$'\n'
  done < <(cut -f1-3 "$ACCOUNTED")
fi

printf 'mutants: %d   killed: %d   survived: %d   explained: %d   unparsable (skipped): %d\n' \
  "$total" "$((total - survived - explained))" "$survived" "$explained" "$skipped"
[[ -n $survivors ]] && printf '\nsurvivors nothing accounts for:\n%s' "$survivors"
[[ -n $stale ]] && printf '\nno longer survive, so their entry has outlived the code:\n%s' "$stale"
[[ -z $survivors && -z $stale ]]
